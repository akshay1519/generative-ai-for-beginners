# Application Settings
ENVIRONMENT=local
DEBUG=True
LOG_LEVEL=INFO

# Azure OpenAI Settings
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=MODEL_NAME_HERE  # e.g., gpt-35-turbo
AZURE_OPENAI_API_VERSION=API_VERSION_HERE  # e.g., 2024-02-01
AZURE_OPENAI_API_KEY=YOUR-API-KEY-HERE  # Add this line

# For local development with API key
USE_MANAGED_IDENTITY=False